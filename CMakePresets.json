{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-ninja",
      "inherits": "base",
      "displayName": "Windows Ninja (MinGW/Clang/MSVC)",
      "description": "Configure build using Ninja generator on Windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC",
      "description": "Configure build using Visual Studio 2019/2022 generator",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-ninja",
      "inherits": "base",
      "displayName": "Linux Ninja",
      "description": "Configure build using Ninja generator on Linux",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja",
      "displayName": "Build Windows Ninja"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "displayName": "Build Windows MSVC"
    },
    {
      "name": "linux-ninja",
      "configurePreset": "linux-ninja",
      "displayName": "Build Linux Ninja"
    }
  ],
  "testPresets": [
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja",
      "displayName": "Test Windows Ninja",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "displayName": "Test Windows MSVC",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-ninja",
      "configurePreset": "linux-ninja",
      "displayName": "Test Linux Ninja",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
